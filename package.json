{
  "name": "untis-mcp",
  "version": "1.0.0",
  "description": "MCP server for WebUntis school scheduling — timetables, substitute finder, room availability, and more",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "untis-mcp": "dist/server.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "untis",
    "mcp",
    "webuntis",
    "model-context-protocol",
    "school",
    "timetable"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.3.1",
    "webuntis": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^4.1.6"
  }
}
