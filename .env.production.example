# WebUntis service account (shared — all teachers use this account internally)
WEBUNTIS_SCHOOL=BZZ
WEBUNTIS_BASE_URL=bzz.webuntis.com
WEBUNTIS_USERNAME=service_account
WEBUNTIS_PASSWORD=your_password_here

# Timezone (IANA format)
SCHOOL_TIMEZONE=Europe/Zurich

# Azure AD / Microsoft Entra ID (reuse from dispensationsgesuche app registration)
# Add https://mcp.your-school.example.com/oauth/microsoft/callback as redirect URI in Azure portal
AZURE_AD_CLIENT_ID=your_client_id
AZURE_AD_CLIENT_SECRET=your_client_secret
AZURE_AD_TENANT_ID=your_tenant_id

# Public base URL of this server (no trailing slash)
BASE_URL=https://mcp.your-school.example.com

# HTTP server port — only exposed to localhost, Apache/Nginx proxies it
PORT=3001
