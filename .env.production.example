# WebUntis credentials
WEBUNTIS_SCHOOL=bzz
WEBUNTIS_USERNAME=service_account
WEBUNTIS_PASSWORD=your_password_here
WEBUNTIS_BASE_URL=bzz.webuntis.com

# Timezone (IANA format)
SCHOOL_TIMEZONE=Europe/Zurich

# MCP access tokens — format: label:token,label:token
# Generate tokens with: ./scripts/generate-token.sh <label>
MCP_TOKENS=alice:TOKEN_A,bob:TOKEN_B

# HTTP server port (default: 3000, only exposed to localhost via docker-compose)
PORT=3000
